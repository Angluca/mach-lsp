# crash containment and recovery: the client-facing half of the server
#
# The analysis worker runs the compiler front end over buffers the user is
# actively breaking. A front-end defect there is an in-process fault - a bad
# dereference, a failed assertion - and `std` exposes no way to trap one, so a
# single-process server dies with it. What the client sees is a closed pipe: no
# error, no message, no indication of which file or which request was involved.
#
# So the process the editor talks to does not run the compiler. It owns the
# client's stdin and stdout, spawns a second copy of this executable with
# `--worker`, and relays frames between them. A fault in the worker is then an
# ordinary child exit, which the parent survives and can explain.
#
# Surviving is not the same as recovering. The state the worker held - open
# documents, their current text, what the client negotiated at `initialize` -
# died with it, and the client will not send any of it again. `mirror` keeps the
# supervisor's own copy of exactly that, built from the frames the client sent,
# so a replacement worker can be brought to the state the dead one was in.
#
# Two threads and one lock:
#
#   - the client pump reads the client, folds each frame into the mirror, and
#     writes it to the current worker;
#   - the main thread relays worker output, and on the worker's death reaps it,
#     spawns a replacement, and arms a replay.
#
# The replay is performed by the client pump rather than by the thread that
# spawned the worker, and that is not an arbitrary split. Replaying a session
# means writing every open document's full text into the worker's input, which
# is far more than a pipe holds; the worker answers with diagnostics for each,
# which is far more than the other pipe holds. Whoever writes the replay must
# not also be the one draining the answers, or the two block against each other
# and the session hangs instead of recovering. The main thread is already
# draining, so the pump writes.
#
# The cost of that split is that a replay waits for the client's next frame. An
# idle client sees a recovered session on its next keystroke rather than
# immediately, which is invisible in practice: the request the worker died on is
# answered with an error straight away, and that is what the client reacts to.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_equals;
use std.types.result.Result;
use std.types.result.is_err;
use std.types.result.unwrap_ok;

use std.allocator.Allocator;

use os:     std.system.os;
use exec:   std.process.exec;
use env:    std.process.env;
use thread: std.sync.thread;
use mutex:  std.sync.mutex;
use atomic: std.sync.atomic;

use sj:        std.data.json;
use json:      mls.json;
use mirror:    mls.mirror;
use transport: mls.transport;
use trace:     mls.trace;

# the argument that selects the worker role
pub val WORKER_FLAG: str = "--worker";

# exit code when the worker died on a signal and could not be recovered,
# distinct from a clean protocol exit (0) and a transport failure (1) so a
# wrapper can tell them apart
pub val EXIT_WORKER_CRASHED: i64 = 3;

# how many times a session will replace a crashed worker
#
# A cap rather than a timed backoff, because there is no sleep to back off with
# and because the thing worth bounding is not the rate but the pointlessness: a
# session that has crashed this many times is not going to stop.
val MAX_RESTARTS: i64 = 5;

# how many replacements may die without ever answering anything
#
# A worker that dies having emitted no frame at all died on the session itself -
# on replay, or on the first thing it was asked - so replacing it again reruns
# exactly what killed it. Two of those in a row is a crash loop, and the useful
# response is to stop and say so rather than to keep spawning.
val MAX_BARREN: i64 = 2;

# the relay's shared state
#
# `to_worker` and `mir` are written by whichever thread holds `mu`; the atomics
# are read across threads without it.
rec Relay {
    alloc:      *Allocator;
    mu:         mutex.Mutex;
    to_worker:  i32;
    mir:        mirror.Mirror;
    stop:       i64;
    last_id:    i64;
    have_id:    i64;
    need_replay: i64;
    swallow:    i64;
}

# one relay per process; the pump thread is handed its address
var RELAY: Relay;

# run as the client-facing supervisor, returning the process exit code
#
# `self` is this executable's path, re-spawned with `--worker`.
pub fun run(alloc: *Allocator, self: str) i64 {
    var to_worker:   [2]i32;
    var from_worker: [2]i32;

    RELAY.alloc       = alloc;
    RELAY.mu          = mutex.make();
    RELAY.stop        = 0;
    RELAY.last_id     = 0;
    RELAY.have_id     = 0;
    RELAY.need_replay = 0;
    RELAY.swallow     = 0;
    mirror.init(?RELAY.mir, alloc);

    var pid: i64 = start_worker(self, ?to_worker[0], ?from_worker[0]);
    if (pid < 0) {
        trace.log("supervisor: could not start the analysis worker\n");
        mirror.dnit(?RELAY.mir);
        ret 1;
    }
    RELAY.to_worker = to_worker[1];

    var pump: thread.Thread;
    thread.spawn_with(pump_client, (?RELAY)::*u8, ?pump);
    if (pump.tid < 0) {
        os.close(to_worker[1]);
        os.close(from_worker[0]);
        trace.log("supervisor: could not start the client pump\n");
        mirror.dnit(?RELAY.mir);
        ret 1;
    }

    var code:     i64 = 0;
    var restarts: i64 = 0;
    var barren:   i64 = 0;
    var reading:  i32 = from_worker[0];

    for (true) {
        var frames: i64 = 0;
        val clean: bool = pump_worker(alloc, reading, ?frames);

        var child: exec.Child;
        child.pid = pid;
        val wr: Result[exec.ExitStatus, str] = exec.wait(child);
        if (is_err[exec.ExitStatus, str](wr)) { code = 1; brk; }
        var status: exec.ExitStatus = unwrap_ok[exec.ExitStatus, str](wr);

        if (!exec.signaled(status)) {
            # a clean or self-reported exit is the worker's own decision - a
            # shutdown, or a transport failure it already described. Replacing
            # it would restart a session the client is finished with.
            if (!clean) { trace.log("supervisor: worker output ended mid-frame\n"); }
            code = exec.code(status)::i64;
            brk;
        }

        val sig: i64 = exec.signal(status)::i64;
        if (frames == 0) { barren = barren + 1; }
        or { barren = 0; }

        val may_retry: bool = restarts < MAX_RESTARTS
                           && barren < MAX_BARREN
                           && mirror.has_session(?RELAY.mir)
                           && atomic.load(?RELAY.stop) == 0;
        if (!may_retry) {
            report_crash(alloc, sig, false);
            code = EXIT_WORKER_CRASHED;
            brk;
        }

        # the request the worker died holding is answered before anything else:
        # the replacement will never have heard of it, so nothing else is going
        # to unblock the client
        report_crash(alloc, sig, true);

        os.close(reading);
        mutex.lock(?RELAY.mu);
        os.close(RELAY.to_worker);
        pid = start_worker(self, ?to_worker[0], ?from_worker[0]);
        if (pid >= 0) {
            RELAY.to_worker = to_worker[1];
            reading         = from_worker[0];
            atomic.store(?RELAY.swallow, 1);
            atomic.store(?RELAY.need_replay, 1);
        }
        mutex.unlock(?RELAY.mu);

        if (pid < 0) {
            trace.log("supervisor: could not restart the analysis worker\n");
            code = EXIT_WORKER_CRASHED;
            brk;
        }
        restarts = restarts + 1;
        trace.logf("supervisor: analysis worker replaced after signal {}", sig);
    }

    atomic.store(?RELAY.stop, 1);
    os.close(reading);
    mutex.lock(?RELAY.mu);
    os.close(RELAY.to_worker);
    RELAY.to_worker = -1;
    mutex.unlock(?RELAY.mu);
    mirror.dnit(?RELAY.mir);
    ret code;
}

# spawn a worker over fresh pipes, returning its pid or a negative value
#
# `to` and `from` receive the pipe pairs; the caller keeps `to[1]` and `from[0]`
# and the child's ends are closed here, because holding them past the child's
# exit would keep the pipes open and turn a crash into a hang.
fun start_worker(self: str, to: *i32, from: *i32) i64 {
    if (os.pipe(to) < 0)   { ret -1; }
    if (os.pipe(from) < 0) { os.close(to[0]); os.close(to[1]); ret -1; }

    var argv: [3]*u8;
    argv[0] = self::*u8;
    argv[1] = WORKER_FLAG::*u8;
    argv[2] = nil;

    # the worker inherits this process's environment. Handing it nil gives the
    # child an EMPTY environment, which silently drops everything a tool reads
    # from it - PATH, locale, MLS_TRACE - and leaves the difference invisible
    # until something that depends on one of them stops working.
    val pid: i64 = os.spawn_redirected(self::*u8, ?argv[0], env.environ(),
                                       to[0], from[1], 2);
    os.close(to[0]);
    os.close(from[1]);
    if (pid < 0) {
        os.close(to[1]);
        os.close(from[0]);
        ret -1;
    }
    ret pid;
}

# forward client frames to the worker, recording what a replay would need
#
# The mirror is folded under the same lock as the write, so a replacement worker
# is never told about a document by a replay and by a live frame in the wrong
# order: whatever the mirror has been told, the worker has been told.
fun pump_client(arg: *u8) {
    val r: *Relay = arg::*Relay;
    for (atomic.load(?r.stop) == 0) {
        var msg: transport.Message;
        val st: transport.ReadStatus = transport.read_message(?msg, r.alloc);
        if (st != transport.READ_OK) { brk; }

        note_request(r, msg.body, msg.body_len);

        mutex.lock(?r.mu);
        var alive: bool = r.to_worker >= 0;
        if (alive && atomic.load(?r.need_replay) != 0) {
            alive = mirror.replay(?r.mir, r.to_worker);
            atomic.store(?r.need_replay, 0);
        }
        mirror.record(?r.mir, msg.body, msg.body_len);
        if (alive) { alive = transport.write_frame_to(r.to_worker, msg.body, msg.body_len); }
        mutex.unlock(?r.mu);

        transport.message_free(?msg, r.alloc);
        if (!alive) { brk; }
    }

    # closing the worker's input is how it learns the client is gone
    mutex.lock(?r.mu);
    if (r.to_worker >= 0) { os.close(r.to_worker); }
    r.to_worker = -1;
    mutex.unlock(?r.mu);
    atomic.store(?r.stop, 1);
}

# forget a request the worker has answered
#
# Without this the parent reports a crash against whichever id it saw last,
# even when the worker had already answered it - two responses for one id,
# which is exactly the rule the worker's own dispatcher backstop exists to
# keep. The parent must know what is actually outstanding, not what was recent.
fun note_response(r: *Relay, body: str, len: usize) bool {
    var relay: bool = true;
    var rd: json.Reader;
    if (!json.reader_init(?rd, r.alloc)) { ret relay; }
    var parsed: json.Message = json.read(?rd, body, len);
    if (parsed.valid) {
        val idv: *sj.Value = json.member(?parsed.root, "id");
        val answered: bool = json.member(?parsed.root, "result") != nil
                          || json.member(?parsed.root, "error") != nil;
        if (idv != nil && answered) {
            val id: str = json.id_text(idv, r.alloc);
            if (id != nil) {
                # a replayed `initialize` is answered with the id the client
                # already holds a response for; forwarding the second one would
                # be two responses for one request
                if (atomic.load(?r.swallow) != 0) {
                    val want: str = mirror.replay_id(?r.mir);
                    if (want != nil && str_equals(id, want)) {
                        atomic.store(?r.swallow, 0);
                        relay = false;
                    }
                }
                if (parse_id(id) == atomic.load(?r.last_id)) { atomic.store(?r.have_id, 0); }
                json.free_str(id, r.alloc);
            }
        }
    }
    json.release(?rd);
    json.reader_dnit(?rd);
    ret relay;
}

# remember the newest request id seen on the client stream
fun note_request(r: *Relay, body: str, len: usize) {
    var rd: json.Reader;
    if (!json.reader_init(?rd, r.alloc)) { ret; }
    var parsed: json.Message = json.read(?rd, body, len);
    if (parsed.valid) {
        val id: str = json.id_text(json.member(?parsed.root, "id"), r.alloc);
        if (id != nil) {
            atomic.store(?r.last_id, parse_id(id));
            atomic.store(?r.have_id, 1);
            json.free_str(id, r.alloc);
        }
    }
    json.release(?rd);
    json.reader_dnit(?rd);
}

# a numeric id's value, or 0 for a string or null id
#
# A crash report names the id only when it is numeric; quoting a string id back
# would mean re-escaping it from a thread that is about to exit, and the message
# is diagnostic rather than protocol.
fun parse_id(token: str) i64 {
    var v: i64 = 0;
    var i: usize = 0;
    val n: usize = str_len(token);
    for (i < n) {
        if (token[i] < '0' || token[i] > '9') { ret 0; }
        v = v * 10 + (token[i]::i64 - '0'::i64);
        i = i + 1;
    }
    ret v;
}

# copy the worker's frames to the client until its end closes
#
# `frames` counts what this worker generation actually produced, which is how a
# worker that died on the session itself is told apart from one that died on a
# particular request.
# ---
# alloc:  the relay allocator
# fd:     the worker's output
# frames: receives the number of frames relayed
# ret:    whether the stream ended on a frame boundary
fun pump_worker(alloc: *Allocator, fd: i32, frames: *i64) bool {
    for (true) {
        var msg: transport.Message;
        val st: transport.ReadStatus = transport.read_message_from(fd, ?msg, alloc);
        if (st == transport.READ_EOF) { ret true; }
        if (st != transport.READ_OK)  { ret false; }
        @frames = @frames + 1;
        if (note_response(?RELAY, msg.body, msg.body_len)) {
            transport.send_message(msg.body, alloc);
        }
        transport.message_free(?msg, alloc);
    }
    ret true;
}

# tell the client the analysis worker died, and answer the request it died on
#
# Two messages, because they serve different readers: the error response
# unblocks the client's pending request, and the showMessage is what the person
# sees. Without the first, an editor waits on that id until it gives up.
#
# `recovering` changes only what the person is told. A session that is coming
# back should not be described in the same words as one that is not, and the
# severity follows: a recovered crash is a warning about work that was lost, a
# final one is an error about a server that has stopped.
fun report_crash(alloc: *Allocator, sig: i64, recovering: bool) {
    trace.logf("supervisor: analysis worker terminated by signal {}", sig);

    if (atomic.load(?RELAY.have_id) != 0) {
        val id: i64 = atomic.load(?RELAY.last_id);
        if (id != 0) {
            var b: json.Buf = json.buf_init(alloc);
            json.buf_push(?b, "{\"jsonrpc\":\"2.0\",\"id\":");
            json.buf_push_i64(?b, id);
            json.buf_push(?b, ",\"error\":{\"code\":-32603,\"message\":");
            json.buf_push_quoted(?b, "the mach analysis worker crashed while handling this request");
            json.buf_push(?b, "}}");
            val msg: str = json.buf_str(?b);
            if (msg != nil) { transport.send_message(msg, alloc); }
            json.buf_dnit(?b);
            atomic.store(?RELAY.have_id, 0);
        }
    }

    var n: json.Buf = json.buf_init(alloc);
    json.buf_push(?n, "{\"jsonrpc\":\"2.0\",\"method\":\"window/showMessage\",\"params\":{\"type\":");
    if (recovering) { json.buf_push(?n, "2"); }
    or             { json.buf_push(?n, "1"); }
    json.buf_push(?n, ",\"message\":");
    var text: json.Buf = json.buf_init(alloc);
    json.buf_push(?text, "mach-lsp: the analysis worker crashed (signal ");
    json.buf_push_i64(?text, sig);
    if (recovering) {
        json.buf_push(?text, "). This is a compiler front-end fault; the server has restarted and restored your open documents.");
    }
    or {
        json.buf_push(?text, "). This is a compiler front-end fault; the language server has stopped.");
    }
    json.buf_push_quoted(?n, json.buf_str(?text));
    json.buf_push(?n, "}}");
    val nmsg: str = json.buf_str(?n);
    if (nmsg != nil) { transport.send_message(nmsg, alloc); }
    json.buf_dnit(?text);
    json.buf_dnit(?n);
}
