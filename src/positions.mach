# byte-offset <-> LSP position conversions and span helpers
#
# the LSP addresses text by 0-based (line, character); the compiler addresses
# it by byte offset (and reports 1-based line/col via `source.position`). the
# language features pivot on byte offset - `ast.offset_to_*` takes an offset
# and the resolve side tables index by node id - so every request first maps
# the incoming LSP position to an offset, and every response maps a `token.Span`
# back to an LSP range. these helpers are the single conversion point.
#
# the compiler core is byte-oriented (parser spans, `source.position`), so the
# byte representation stays internal and the conversion to and from the
# protocol's UTF-16 code-unit `character` happens only here, at the boundary.
# lines are encoding-agnostic (newlines are single-byte), so only the column is
# converted: inbound, a UTF-16 column walks the line's UTF-8 to a byte offset;
# outbound, a byte offset's line prefix is measured in UTF-16 code units. the
# server advertises no `positionEncoding`, so the client's UTF-16 default holds.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use std.allocator.Allocator;
use std.allocator.allocate;

use mem: std.memory;

use mach.lang.fe.token;
use src: mach.lang.source;

# a 0-based LSP range, the form a `Location` / hover range needs
# ---
# start_line: 0-based start line
# start_char: 0-based start character (UTF-16 code-unit column)
# end_line:   0-based end line
# end_char:   0-based end character (UTF-16 code-unit column)
pub rec LspRange {
    start_line: usize;
    start_char: usize;
    end_line:   usize;
    end_char:   usize;
}

# a source file paired with the byte length of its text
#
# `src.SourceFile` does not carry its length, so the only way to learn it is to
# scan for the terminating NUL. Doing that inside `span_text` meant every symbol
# name copied out of a document rescanned the whole document, which made the
# cost of a response grow with the PRODUCT of how many spans it names and how
# big the file is. On a 2000-line module that was two thirds of documentSymbol's
# time, spent entirely on rediscovering one number.
#
# The length travels with the file rather than beside it because a bound passed
# separately is a bound a caller can take from the wrong file, and a span copied
# against another file's length reads off the end of this one. `text_of` is the
# only way to build one, so the pair is correct by construction.
#
# A Text may also be READ AGAINST a newer buffer. A project snapshot built before
# the client's latest edits indexes text the client no longer has, and answering
# from it is still better than not answering (#251), provided no position crosses
# the boundary unmapped. So the analyzed file can carry the client's `live` file
# and the window where the two differ: every offset the analysis reports is
# carried into `live` on the way out, and every position the client sends is
# carried back on the way in. This is the single conversion point, so a feature
# answering from a stale snapshot needs no knowledge that it is doing so.
# ---
# file:     the source file every analysis offset indexes
# len:      byte length of `file.text`, excluding the terminator
# live:     the client's buffer when it differs from `file`, else nil
# live_len: byte length of `live.text`
# win:      where `file` and `live` differ, meaningful only when `live` is set
pub rec Text {
    file:     *src.SourceFile;
    len:      usize;
    live:     *src.SourceFile;
    live_len: usize;
    win:      Window;
}

# the one region where an analyzed text and the client's buffer differ
#
# The two texts share a prefix and a suffix, and everything between is the
# window: `[start, old_end)` in the analyzed text, `[start, new_end)` in the
# client's. Offsets before it are equal in both, offsets after it differ by the
# length change, and offsets inside it have no counterpart. One window rather
# than a list of edits, because the two texts are all that is known and their
# common prefix and suffix bound every edit between them. Edits spread across a
# file widen it, which degrades toward answering nothing, never toward answering
# wrongly.
# ---
# start:   first differing byte, in both texts
# old_end: end of the difference in the analyzed text
# new_end: end of the difference in the client's text
pub rec Window {
    start:   usize;
    old_end: usize;
    new_end: usize;
}

# pair `file` with its text length, scanning once
# ---
# file: the source file to measure, may be nil
# ret:  the file paired with its length
pub fun text_of(file: *src.SourceFile) Text {
    var t: Text;
    t.file     = file;
    t.len      = 0;
    t.live     = nil;
    t.live_len = 0;
    t.win      = Window{start: 0, old_end: 0, new_end: 0};
    if (file != nil) { t.len = str_len(file.text); }
    ret t;
}

# `analyzed` read against the client's `live` buffer
#
# Identical texts need no window, so they pair as `text_of` would: a document
# whose snapshot is current costs nothing here beyond the comparison.
# ---
# analyzed: the file the analysis offsets index
# live:     the client's current buffer
# ret:      the pairing, carrying the window when the texts differ
pub fun text_against(analyzed: *src.SourceFile, live: *src.SourceFile) Text {
    var t: Text = text_of(analyzed);
    if (analyzed == nil || live == nil || analyzed == live) { ret t; }
    val live_len: usize  = str_len(live.text);
    val w:        Window = window_between(analyzed.text, t.len, live.text, live_len);
    if (w.start == w.old_end && w.start == w.new_end) { ret t; }
    t.live     = live;
    t.live_len = live_len;
    t.win      = w;
    ret t;
}

# the window where `old` and `new` differ: their common prefix and suffix,
# with the suffix never overlapping the prefix in either text
pub fun window_between(old: str, old_len: usize, new: str, new_len: usize) Window {
    var p: usize = 0;
    for (p < old_len && p < new_len && old[p] == new[p]) { p = p + 1; }
    var q: usize = 0;
    for (q < old_len - p && q < new_len - p && old[old_len - 1 - q] == new[new_len - 1 - q]) { q = q + 1; }
    ret Window{start: p, old_end: old_len - q, new_end: new_len - q};
}

# `span` carried into the client's buffer, or none when it cannot be
#
# A span wholly before the window keeps its offsets, and one wholly after it
# moves by the length change. A span that ENCLOSES the window - a declaration
# around the edit - still has both ends outside it and keeps its meaning, so it
# is carried when `enclosing` allows; a caller whose span's content is the claim,
# such as a stale diagnostic, refuses it. Any other overlap has no counterpart.
# ---
# t:         the pairing the span's offsets index
# span:      a span of `t.file`
# enclosing: whether a span around the whole window may be carried
# ret:       the same bytes' span in the client's buffer, or none
pub fun live_span(t: Text, span: token.Span, enclosing: bool) opt[token.Span] {
    if (t.live == nil) { ret opt[token.Span].some{span}; }
    val a:     usize = span.offset;
    val b:     usize = span.offset + span.len;
    val delta: i64   = t.win.new_end::i64 - t.win.old_end::i64;
    var out:   token.Span;
    out.offset = a;
    out.len    = span.len;
    if (b <= t.win.start) { ret opt[token.Span].some{out}; }
    if (a >= t.win.old_end) {
        out.offset = (a::i64 + delta)::usize;
        ret opt[token.Span].some{out};
    }
    if (enclosing && a < t.win.start && b >= t.win.old_end) {
        out.len = (b::i64 + delta)::usize - a;
        ret opt[token.Span].some{out};
    }
    ret opt[token.Span].none{};
}

# whether `span` can be reported to the client, enclosing spans included
pub fun maps(t: Text, span: token.Span) bool {
    val o: opt[token.Span] = live_span(t, span, true);
    ret sel o.some;
}

# the analyzed offset for the client's offset `q`, or none inside the window.
# a cursor at the start of inserted or replaced text touches text the analysis
# never saw, so it is inside
fun analyzed_offset(t: Text, q: usize) opt[usize] {
    if (t.live == nil)      { ret opt[usize].some{q}; }
    if (q < t.win.start)    { ret opt[usize].some{q}; }
    if (q >= t.win.new_end) { ret opt[usize].some{q - t.win.new_end + t.win.old_end}; }
    ret opt[usize].none{};
}

# the file the client's positions index: its live buffer when one is paired
fun client_file(t: Text) *src.SourceFile {
    if (t.live != nil) { ret t.live; }
    ret t.file;
}

# the byte length of `client_file(t)`
fun client_len(t: Text) usize {
    if (t.live != nil) { ret t.live_len; }
    ret t.len;
}

# the analysis offset of a 0-based LSP (line, character), or none when the
# line is out of range or the position lies in a paired buffer's window. the
# position indexes the client's buffer; its UTF-16 column is resolved by walking
# that line's UTF-8, clamped to the line's end
# ---
# t:    the pairing the analysis indexes
# line: 0-based LSP line
# ch:   0-based LSP character (UTF-16 code-unit column)
# ret:  some(offset) into `t.file`, or none
pub fun offset_at(t: Text, line: usize, ch: usize) opt[usize] {
    val qo: opt[usize] = client_offset(t, line, ch);
    if (sel qo.none) { ret qo; }
    ret analyzed_offset(t, qo.some);
}

# as `offset_at`, for one end of a range the client uses as a filter rather
# than a cursor: a bound inside the window widens to the window's edge instead
# of failing, so a visible range that spans an edit still covers what the
# analysis can say about either side of it
# ---
# t:      the pairing the analysis indexes
# line:   0-based LSP line
# ch:     0-based LSP character
# is_end: whether this is the range's end
# ret:    some(offset) into `t.file`, or none for an out-of-range line
pub fun bound_at(t: Text, line: usize, ch: usize, is_end: bool) opt[usize] {
    val qo: opt[usize] = client_offset(t, line, ch);
    if (sel qo.none) { ret qo; }
    val ao: opt[usize] = analyzed_offset(t, qo.some);
    if (sel ao.some) { ret ao; }
    if (is_end)      { ret opt[usize].some{t.win.old_end}; }
    ret opt[usize].some{t.win.start};
}

# the byte offset of a 0-based LSP position in the client's buffer
fun client_offset(t: Text, line: usize, ch: usize) opt[usize] {
    val file: *src.SourceFile = client_file(t);
    if (file == nil) { ret opt[usize].none{}; }
    val ls: opt[usize] = src.line_start(file, line + 1);
    if (sel ls.none) { ret opt[usize].none{}; }
    val ls_off: usize = ls.some;

    var le_off: usize = client_len(t);
    if (line + 1 < file.line_len) { le_off = file.line_starts[line + 1]; }

    ret opt[usize].some{u16_col_to_byte(file, ls_off, le_off, ch)};
}

# the client's LSP range for a span of the analyzed text, or none when the span
# cannot be carried into the client's buffer
# ---
# t:    the pairing the span indexes
# span: a span of `t.file`
# ret:  the 0-based range in the client's buffer, or none
pub fun span_range(t: Text, span: token.Span) opt[LspRange] {
    if (t.file == nil) { ret opt[LspRange].none{}; }
    val lo: opt[token.Span] = live_span(t, span, true);
    if (sel lo.none) { ret opt[LspRange].none{}; }
    ret opt[LspRange].some{range_of(client_file(t), lo.some)};
}

# as `span_range`, refusing a span that encloses the window: for a claim about
# the span's own content, which the edit may have changed
pub fun span_range_disjoint(t: Text, span: token.Span) opt[LspRange] {
    if (t.file == nil) { ret opt[LspRange].none{}; }
    val lo: opt[token.Span] = live_span(t, span, false);
    if (sel lo.none) { ret opt[LspRange].none{}; }
    ret opt[LspRange].some{range_of(client_file(t), lo.some)};
}

# the LSP range covering a byte span in `file`. a zero-length span
# yields an empty range at its offset. columns are reported as UTF-16 code-unit
# offsets within their line
# ---
# file: the source file the span addresses
# span: the byte range to convert
# ret:  the equivalent 0-based LSP range
pub fun range_of(file: *src.SourceFile, span: token.Span) LspRange {
    var r:  LspRange;
    val sp: src.Position = src.position(file, span.offset);
    r.start_line = dec(sp.line);
    r.start_char = u16_col(file, sp.line, span.offset);

    var end_off: usize = span.offset + span.len;
    if (span.len == 0) { end_off = span.offset; }
    val ep: src.Position = src.position(file, end_off);
    r.end_line = dec(ep.line);
    r.end_char = u16_col(file, ep.line, end_off);
    if (r.end_line == r.start_line && r.end_char < r.start_char) { r.end_char = r.start_char; }
    ret r;
}

# whether the bytes under `span` in `t` spell `name`, without copying
# ---
# t:    the source file paired with its length
# span: the byte range to compare
# name: the text to compare against
# ret:  true when the span is in bounds and spells `name` exactly
pub fun span_equals(t: Text, span: token.Span, name: str) bool {
    if (name == nil || t.file == nil)                           { ret false; }
    if (span.offset >= t.len || span.offset + span.len > t.len) { ret false; }
    if (span.len != str_len(name))                              { ret false; }
    var i: usize = 0;
    for (i < span.len) {
        if (t.file.text[span.offset + i] != name[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# an owned copy of the source text a span covers, nil-terminated, or
# nil on an empty span / allocation failure. used to render the spelling of a
# decl name or type as written
# ---
# t:     the source file paired with its length
# span:  the byte range to copy
# alloc: allocator backing the returned string
# ret:   owned copy of the span text, or nil
pub fun span_text(t: Text, span: token.Span, alloc: *Allocator) str {
    if (span.len == 0 || t.file == nil) { ret nil; }
    if (span.offset >= t.len)           { ret nil; }
    var len: usize = span.len;
    if (span.offset + len > t.len) { len = t.len - span.offset; }

    val r: res[*u8, allocator.Error] = allocate[u8](alloc, len + 1);
    if (sel r.err) { ret nil; }
    val buf: *u8 = r.ok;
    mem.raw_copy(buf::ptr, (t.file.text::usize + span.offset)::ptr, len);
    buf[len] = 0;
    ret buf::str;
}

# the 0-based UTF-16 code-unit column of a byte `offset` on its
# 1-based `line`, measured by walking the line prefix's UTF-8
# ---
# file:   the source file the offset addresses
# line:   1-based line the offset falls on (as `source.position` reports)
# offset: byte offset whose column is measured
# ret:    0-based UTF-16 code-unit column
fun u16_col(file: *src.SourceFile, line: usize, offset: usize) usize {
    var o:     usize = file.line_starts[line - 1];
    var units: usize = 0;
    for (o < offset) {
        val b: u8 = file.text[o];
        units = units + u16_units(b);
        o     = o + u8_seq_len(b);
    }
    ret units;
}

# the byte offset of a 0-based UTF-16 code-unit column on the
# line spanning [start, end), or `end` when the column runs past the line. a
# column landing inside a codepoint snaps to that codepoint's start
# ---
# file:  the source file
# start: byte offset of the line's first byte
# end:   byte offset just past the line (exclusive walk bound)
# col:   0-based UTF-16 code-unit column to locate
# ret:   the byte offset at that column, clamped to `end`
fun u16_col_to_byte(file: *src.SourceFile, start: usize, end: usize, col: usize) usize {
    var o:     usize = start;
    var units: usize = 0;
    for (o < end) {
        val b: u8    = file.text[o];
        val u: usize = u16_units(b);
        if (units + u > col) { brk; }
        units = units + u;
        o     = o + u8_seq_len(b);
    }
    ret o;
}

# the byte length of the UTF-8 sequence led by `b`; a stray
# continuation byte counts as 1 so malformed input still advances
fun u8_seq_len(b: u8) usize {
    if (b < 0xC0) { ret 1; }
    if (b < 0xE0) { ret 2; }
    if (b < 0xF0) { ret 3; }
    ret 4;
}

# the UTF-16 code units the codepoint led by `b` encodes to - 2 for a
# 4-byte sequence (a surrogate pair), 1 otherwise
fun u16_units(b: u8) usize {
    if (b >= 0xF0) { ret 2; }
    ret 1;
}

# clamp `n - 1` at 0 (1-based compiler position -> 0-based LSP position)
fun dec(n: usize) usize {
    if (n == 0) { ret 0; }
    ret n - 1;
}

# the byte offset of a 0-based LSP (line, character) within raw text
#
# The file-based `offset_at` needs a `SourceFile` and its line index, which an
# open document does not carry: it owns text. Incremental sync applies edits to
# that text before any of it reaches the compiler, so the conversion has to work
# from the bytes alone. Same UTF-16 column rule, same clamping - a character
# past the end of its line lands at the line's end rather than failing, which is
# what a client sends when it means "end of line".
# ---
# text: the buffer to index
# line: 0-based LSP line
# ch:   0-based LSP character (UTF-16 code-unit column)
# ret:  some(offset), or none when the line is past the end of the text
pub fun offset_in_text(text: str, line: usize, ch: usize) opt[usize] {
    if (text == nil) { ret opt[usize].none{}; }
    val n: usize = str_len(text);

    var start: usize = 0;
    var seen:  usize = 0;
    for (seen < line && start < n) {
        if (text[start] == '\n') { seen = seen + 1; }
        start = start + 1;
    }
    # a client may address the position one past the last line, which is where
    # an append lands; anything beyond that is out of range
    if (seen < line) {
        if (seen + 1 == line && start == n) { ret opt[usize].some{n}; }
        ret opt[usize].none{};
    }

    var end: usize = start;
    for (end < n && text[end] != '\n') { end = end + 1; }

    var o:     usize = start;
    var units: usize = 0;
    for (o < end) {
        val b: u8    = text[o];
        val u: usize = u16_units(b);
        if (units + u > ch) { brk; }
        units = units + u;
        o     = o + u8_seq_len(b);
    }
    ret opt[usize].some{o};
}

use std.allocator.page;
use std.types.string.str_equals;

use std.allocator;

# test helpers over an optional offset, since a call result cannot be guarded
fun some_is(o: opt[usize], want: usize) bool {
    if (sel o.some) { ret o.some == want; }
    ret false;
}

fun some_present(o: opt[usize]) bool {
    ret sel o.some;
}

test "positions: a text offset resolves line and utf-16 column" {
    var fail: bool = false;
    val t:    str  = "ab\ncdef\n";
    if (!some_is(offset_in_text(t, 0, 0), 0)) { fail = true; }
    if (!some_is(offset_in_text(t, 0, 2), 2)) { fail = true; }
    if (!some_is(offset_in_text(t, 1, 0), 3)) { fail = true; }
    if (!some_is(offset_in_text(t, 1, 3), 6)) { fail = true; }
    # a column past the end of its line clamps to the line's end
    if (!some_is(offset_in_text(t, 0, 99), 2)) { fail = true; }
    # the position one past the final newline is where an append lands
    if (!some_is(offset_in_text(t, 2, 0), 8))  { fail = true; }
    if (some_present(offset_in_text(t, 9, 0))) { fail = true; }
    if (fail)                                  { ret 1; }
    ret 0;
}

# a 4-byte sequence is one codepoint but TWO utf-16 units, so a column past it
# must not be read as a byte count
test "positions: an astral codepoint counts as two utf-16 units" {
    var fail: bool = false;
    # "a" + U+1F600 (4 bytes) + "b"
    val t: str = "a\xF0\x9F\x98\x80b";
    if (!some_is(offset_in_text(t, 0, 1), 1)) { fail = true; }
    if (!some_is(offset_in_text(t, 0, 3), 5)) { fail = true; }
    if (fail)                                 { ret 1; }
    ret 0;
}

# `Text` exists so a span is never copied against a length taken from another
# file, and so the length is discovered once rather than once per span. Both
# properties are invisible at a call site, so they are pinned here.
test "positions: a text pairs a file with its own length" {
    var starts: [3]usize;
    starts[0] = 0;
    starts[1] = 3;
    starts[2] = 6;
    var f:    src.SourceFile = t_file("ab\ncd\nef", ?starts[0], 3);
    val t:    Text           = text_of(?f);
    var fail: bool           = false;
    if (t.len != 8)     { fail = true; }
    if (t.file != (?f)) { fail = true; }
    # a nil file is a well-formed empty pairing, not a crash: `callee_file`
    # returns one when a call's target cannot be resolved
    val e: Text = text_of(nil);
    if (e.file != nil || e.len != 0) { fail = true; }
    if (fail)                        { ret 1; }
    ret 0;
}

# the bound is what stops a span from a stale tree reading past the buffer it is
# applied to; dropping it was the whole cost of pairing the length with the file
test "positions: span text stays inside the file it is bounded by" {
    var pa: Allocator;
    page.make(?pa);
    var starts: [1]usize;
    starts[0] = 0;
    var f:    src.SourceFile = t_file("abcdef", ?starts[0], 1);
    val t:    Text           = text_of(?f);
    var fail: bool           = false;

    val whole: str = span_text(t, t_span(0, 6), ?pa);
    if (whole == nil || !str_equals(whole, "abcdef")) { fail = true; }

    # a span running past the end is clamped, not read out of bounds
    val over: str = span_text(t, t_span(4, 99), ?pa);
    if (over == nil || !str_equals(over, "ef")) { fail = true; }

    # a span starting past the end has nothing to copy
    if (span_text(t, t_span(6, 1), ?pa) != nil)            { fail = true; }
    if (span_text(t, t_span(0, 0), ?pa) != nil)            { fail = true; }
    if (span_text(text_of(nil), t_span(0, 1), ?pa) != nil) { fail = true; }

    if (fail) { ret 1; }
    ret 0;
}

# `offset_at` reads the final line's end from the pairing rather than rescanning
test "positions: the last line ends at the paired length" {
    var starts: [2]usize;
    starts[0] = 0;
    starts[1] = 3;
    var f:    src.SourceFile = t_file("ab\ncdef", ?starts[0], 2);
    val t:    Text           = text_of(?f);
    var fail: bool           = false;
    if (!some_is(offset_at(t, 1, 4), 7)) { fail = true; }
    # a column past the last line's end clamps to that end, not to the file's
    if (!some_is(offset_at(t, 1, 99), 7))            { fail = true; }
    if (some_present(offset_at(text_of(nil), 0, 0))) { fail = true; }
    if (fail)                                        { ret 1; }
    ret 0;
}

# a stale analysis is answered through the window: before it offsets hold, after
# it they move by the length change, inside it nothing crosses
test "positions: a paired text maps spans around the window" {
    var old_starts: [3]usize;
    old_starts[0] = 0;
    old_starts[1] = 7;
    old_starts[2] = 8;
    var new_starts: [3]usize;
    new_starts[0] = 0;
    new_starts[1] = 10;
    new_starts[2] = 11;
    # "val a = 1;" became "val abcd = 1;" on line 0; line 1 is untouched
    var old:  src.SourceFile = t_file("val a;\n\nfoo bar", ?old_starts[0], 3);
    var new:  src.SourceFile = t_file("val abcd;\n\nfoo bar", ?new_starts[0], 3);
    val t:    Text           = text_against(?old, ?new);
    var fail: bool           = false;
    if (t.live != (?new))                                             { fail = true; }
    if (t.win.start != 5 || t.win.old_end != 5 || t.win.new_end != 8) { fail = true; }

    # "val " is before the window
    if (!span_is(live_span(t, t_span(0, 3), false), 0, 3)) { fail = true; }
    # "foo" moves by three bytes
    if (!span_is(live_span(t, t_span(8, 3), false), 11, 3)) { fail = true; }
    # "a" ends at an insertion point and keeps its place
    if (!span_is(live_span(t, t_span(4, 1), false), 4, 1)) { fail = true; }
    # ";" starts at the insertion point and moves with what follows
    if (!span_is(live_span(t, t_span(5, 1), false), 8, 1)) { fail = true; }
    # "a;" encloses the insertion: carried only when enclosing is allowed
    if (!span_is(live_span(t, t_span(4, 2), true), 4, 5)) { fail = true; }
    if (span_present(live_span(t, t_span(4, 2), false)))  { fail = true; }

    # a cursor on the inserted "bcd" has no analysis; one on "foo" does
    if (some_present(offset_at(t, 0, 6))) { fail = true; }
    if (!some_is(offset_at(t, 2, 1), 9))  { fail = true; }
    if (!some_is(offset_at(t, 0, 2), 2))  { fail = true; }
    # a range bound inside the window widens to its edge
    if (!some_is(bound_at(t, 0, 6, false), 5)) { fail = true; }
    if (!some_is(bound_at(t, 0, 6, true), 5))  { fail = true; }

    # the reported range indexes the client's lines
    val ro: opt[LspRange] = span_range(t, t_span(8, 3));
    if (sel ro.some) {
        if (ro.some.start_line != 2 || ro.some.start_char != 0) { fail = true; }
    }
    or        { fail = true; }
    if (fail) { ret 1; }
    ret 0;
}

# a replacement removes bytes, so a span inside what was replaced has no
# counterpart even at the window's first byte
test "positions: a replaced range refuses what it replaced" {
    var starts: [1]usize;
    starts[0] = 0;
    var old:  src.SourceFile = t_file("abcXYZdef", ?starts[0], 1);
    var new:  src.SourceFile = t_file("abcQdef", ?starts[0], 1);
    val t:    Text           = text_against(?old, ?new);
    var fail: bool           = false;
    if (t.win.start != 3 || t.win.old_end != 6 || t.win.new_end != 4) { fail = true; }
    if (span_present(live_span(t, t_span(3, 1), true)))               { fail = true; }
    if (span_present(live_span(t, t_span(5, 2), true)))               { fail = true; }
    if (!span_is(live_span(t, t_span(6, 3), false), 4, 3))            { fail = true; }
    # an empty span at the window's start is a point before it
    if (!span_is(live_span(t, t_span(3, 0), false), 3, 0)) { fail = true; }
    # the cursor at the replacement's first byte is in text the analysis never saw
    if (some_present(offset_at(t, 0, 3))) { fail = true; }
    if (!some_is(offset_at(t, 0, 4), 6))  { fail = true; }
    if (fail)                             { ret 1; }
    ret 0;
}

# identical texts pair as an unmapped text, so a current snapshot costs nothing
test "positions: identical texts carry no window" {
    var starts: [1]usize;
    starts[0] = 0;
    var a: src.SourceFile = t_file("same", ?starts[0], 1);
    var b: src.SourceFile = t_file("same", ?starts[0], 1);
    val t: Text           = text_against(?a, ?b);
    if (t.live != nil) { ret 1; }
    ret 0;
}

fun span_is(o: opt[token.Span], offset: usize, len: usize) bool {
    if (sel o.some) { ret o.some.offset == offset && o.some.len == len; }
    ret false;
}

fun span_present(o: opt[token.Span]) bool {
    ret sel o.some;
}

# a SourceFile over `text` with a real line index, for the tests above
fun t_file(text: str, starts: *usize, nlines: usize) src.SourceFile {
    var f: src.SourceFile;
    f.present     = true;
    f.revision    = 0;
    f.path        = "t.mach";
    f.text        = text;
    f.line_starts = starts;
    f.line_len    = nlines;
    ret f;
}

fun t_span(offset: usize, len: usize) token.Span {
    var s: token.Span;
    s.offset = offset;
    s.len    = len;
    ret s;
}
